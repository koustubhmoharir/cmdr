# Synthetic ASP.NET-style environment file. Not a real configuration.
ASPNETCORE_ENVIRONMENT=Development
export ASPNETCORE_URLS="http://+:5000;https://+:5001"

# Logging levels, as ASP.NET Core reads the Logging__ keys.
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore = Warning   # trailing comment
Logging__LogLevel__Microsoft.EntityFrameworkCore='Error'

ConnectionStrings__Main="Server=db;Database=app;User Id=app;Password=p@ss#1"
Greeting=hello # comment after unquoted
Empty=
QuotedEmpty=""
Banner="line one
line two"
Single='it is $HOME'
Escaped="tab\there \"quoted\" back\\slash \q"
Expand="${HOME}/data"   # expansion is kept as written
Plain=/var/data/app
  Indented   =   spaced value
Plain=/second/copy
# end of file