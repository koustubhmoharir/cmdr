// This is a JSON5 example document.
{
  unquoted: 'and you can quote me on that',
  singleQuotes: 'I can use "double quotes" here',
  lineBreaks: "Look, Mom! \
No \\n's!",
  hexadecimal: 0xdecaf,
  leadingDecimalPoint: .8675309, andTrailing: 8675309.,
  positiveSign: +1,
  trailingComma: 'in objects', andIn: ['arrays',],
  "backwardsCompatible": "with JSON",
  infinite: Infinity,
  notANumber: NaN,
  negative: -Infinity,
  true: true,
  null: null,
  \u0061bc: 'escaped identifier',
  'quoted-key': 1,
  "$": 2, _: 3,
}
