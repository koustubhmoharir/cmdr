<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained NuGet config for cmdr: <clear /> keeps user and machine configs out, so restore behaves the same on
  every machine and from every directory.

  The source key must stay "nuget", the same name the Terminal.Gui submodule's nuget.config uses. Package source
  mapping matches sources by key, not by URL, so a restore of Cmdr.slnx (which includes the submodule's projects)
  fails with NU1100 if the two configs name the nuget.org feed differently.

  Terminal.Gui itself is a ProjectReference to the submodule, so cmdr does not need the submodule's LocalPackages feed.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
