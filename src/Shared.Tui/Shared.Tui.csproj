<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Shared.Core\Shared.Core.csproj" />
  </ItemGroup>

  <!--
    Terminal.Gui is built from the fork in the Terminal.Gui submodule, not from the NuGet package: the fork carries
    performance fixes that are not upstream yet. The build properties are TerminalGuiBuildProperties in
    Directory.Build.props.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Terminal.Gui\Terminal.Gui\Terminal.Gui.csproj"
                      AdditionalProperties="$(TerminalGuiBuildProperties)" />
  </ItemGroup>

  <!-- A clone without the submodule would otherwise fail with hundreds of missing-type errors. -->
  <Target Name="CheckTerminalGuiSubmodule" BeforeTargets="CollectPackageReferences;ResolveProjectReferences"
          Condition="!Exists('$(MSBuildThisFileDirectory)..\..\Terminal.Gui\Terminal.Gui\Terminal.Gui.csproj')">
    <Error Text="The Terminal.Gui submodule is missing. Run: git submodule update --init" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Shared.Tui.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Embedded so that an application publishing as a single file has no separate .pdb. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
