<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Cmdr.Core\Cmdr.Core.csproj" />
  </ItemGroup>

  <!--
    Terminal.Gui is built from the fork in the Terminal.Gui submodule, not from the NuGet package: the fork carries
    performance fixes that are not upstream yet. Its GitVersion step, pack-on-build and side files
    (pdb, xml docs) are turned off here, so publishing still yields one file.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Terminal.Gui\Terminal.Gui\Terminal.Gui.csproj"
                      AdditionalProperties="DisableGitVersionTask=true;GeneratePackageOnBuild=false;DebugType=embedded;GenerateDocumentationFile=false" />
  </ItemGroup>

  <!-- A clone without the submodule would otherwise fail with hundreds of missing-type errors. -->
  <Target Name="CheckTerminalGuiSubmodule" BeforeTargets="CollectPackageReferences;ResolveProjectReferences"
          Condition="!Exists('$(MSBuildThisFileDirectory)..\..\Terminal.Gui\Terminal.Gui\Terminal.Gui.csproj')">
    <Error Text="The Terminal.Gui submodule is missing. Run: git submodule update --init" />
  </Target>

  <!--
    Thread-pool workers go to sleep as soon as they run out of work instead of spinning first. Every chunk a command
    writes wakes a worker (the pipe reads are async), and the spin after each wake-up cost several percent of a core
    while a command streams output, against about a third of that without it.
  -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Threading.ThreadPool.UnfairSemaphoreSpinLimit" Value="0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cmdr.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Publishing: one framework-dependent executable (needs the .NET runtime installed).
    dotnet publish src/Cmdr -c Release -r win-x64     (or linux-x64, osx-arm64, ...)
    Native libraries of dependencies are bundled too and extracted on first run; only English resources are kept.
  -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
